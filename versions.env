# Pinned releases. cluster/*.sh sources this file.
KNATIVE_VERSION=knative-v1.23.0
SERVING_CRDS_URL=https://github.com/knative/serving/releases/download/knative-v1.23.0/serving-crds.yaml
SERVING_CORE_URL=https://github.com/knative/serving/releases/download/knative-v1.23.0/serving-core.yaml
ISTIO_URL=https://github.com/knative-extensions/net-istio/releases/download/knative-v1.23.0/istio.yaml
NET_ISTIO_URL=https://github.com/knative-extensions/net-istio/releases/download/knative-v1.23.0/net-istio.yaml
# Label on the ingressgateway Service inside istio.yaml.
ISTIO_VERSION=1.29.2
# kind v0.32.0 default node image. Knative 1.23 requires Kubernetes >= 1.34.
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
CLUSTER_NAME=knative
KUBE_CONTEXT=kind-knative
DOMAIN=example.com
INGRESS_CLASS=istio.ingress.networking.knative.dev
# Host ports stay off 8080/8443. Those are already mapped by the k8s-lab kind cluster.
HOST_HTTP_PORT=18080
HOST_HTTPS_PORT=18443
# NodePorts must match extraPortMappings in cluster/kind.yaml.
NODE_HTTP_PORT=31080
NODE_HTTPS_PORT=31443
SAMPLE_NAME=echo-server
SAMPLE_NAMESPACE=default
